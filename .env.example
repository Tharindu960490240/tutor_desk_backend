# ---- Required ----
# Postgres connection string (Neon / Vercel Postgres / Supabase / local)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Long random string used to sign logins – generate with: openssl rand -hex 32
JWT_SECRET=change-me
# Address(es) of the web app, comma-separated ("*" wildcard allowed for preview deployments)
FRONTEND_URL=http://localhost:3000

# ---- Admin ----
# Email(s) of accounts that can open the admin panel (comma-separated). Sign up with this email first.
ADMIN_EMAILS=

# ---- Testing period ----
# Starting invite code. After launch you can change it (or open/close sign-ups) in the admin panel.
SIGNUP_CODE=

# ---- Email (Gmail) ----
# The Gmail address that sends emails, and a 16-character App Password (NOT your normal password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Name shown as the sender
MAIL_FROM_NAME=TutorDesk
# Where tester feedback is sent (defaults to GMAIL_USER)
FEEDBACK_EMAIL=
# Address used in emailed links (defaults to the first FRONTEND_URL)
APP_URL=
# Local testing only: print emails to the console instead of sending them
# MAIL_TRANSPORT=log
